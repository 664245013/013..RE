# คัดลอกเป็น .streamlit/secrets.toml (ห้าม commit)
# บน Streamlit Community Cloud ให้วางเนื้อหานี้ที่ App settings -> Secrets
[neo4j]
uri = "neo4j+s://YOUR_INSTANCE.databases.neo4j.io"
username = "neo4j"
password = "YOUR_PASSWORD"
# database เว้นว่างได้ (ใช้ database หลักของ instance)
# database = "neo4j"
